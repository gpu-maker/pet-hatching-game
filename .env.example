# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pet-hatching-game
# For local SQLite alternative:
# DATABASE_URL=./data/game.db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Game Settings
MAX_PLAYERS_PER_SERVER=500
AUTO_SAVE_INTERVAL=30000
COIN_GENERATION_RATE=1

# Socket.IO
SOCKET_CORS=http://localhost:5500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Trading
MAX_TRADE_TIMEOUT=60000
TRADE_TAX_PERCENTAGE=5
